# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production-use-random-string

# Show dev sample-data toolbar on /artist/intake (also on when FLASK_ENV=development)
DEV_SAMPLE_DATA=1

# Database
# SQLite for development (no setup needed)
DATABASE_URL=sqlite:///soundmatch.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://username:password@localhost/soundmatch

# Redis (optional - for background jobs)
# Only needed if you want to run RQ workers for async ingestion
# If not set, ingestion will run synchronously
REDIS_URL=redis://localhost:6379/0

# Reddit API (OPTIONAL - only needed for RedditConnector)
# Get these from: https://www.reddit.com/prefs/apps
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create app" or "create another app"
# 3. Choose "script" as the app type
# 4. Copy the client ID (under the app name) and secret
# 5. Set a redirect URI (can be http://localhost for dev)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=soundmatch-mvp/1.0 by /u/yourusername

# Matching Engine Weights (0.0-1.0, should sum to ~1.0; normalized at runtime)
MATCH_WEIGHT_GENRE=0.22
MATCH_WEIGHT_SERVICE=0.20
MATCH_WEIGHT_BUDGET=0.10
MATCH_WEIGHT_GOAL=0.08
MATCH_WEIGHT_MATURITY=0.08
MATCH_WEIGHT_PROOF=0.08
MATCH_WEIGHT_TIMEZONE=0.02
MATCH_WEIGHT_LANGUAGE=0.02
MATCH_WEIGHT_CONFIDENCE=0.05
MATCH_WEIGHT_AUDIENCE_FIT=0.08
MATCH_WEIGHT_CHANNEL_FIT=0.05
MATCH_WEIGHT_LYRICAL_THEMES=0.02

# SerpAPI (web search discovery)
SERPAPI_API_KEY=

# Discovery / verification thresholds
DISCOVERY_MIN_CONFIDENCE=30
DISCOVERY_MAX_CANDIDATES=25
# Run discovery synchronously in admin (default). Set DISCOVERY_USE_QUEUE=true only with Redis + rq worker.
# DISCOVERY_USE_QUEUE=false
# DISCOVERY_FORCE_SYNC=true

# SerpAPI budget: only this many searches per cycle (default 2). Queries rotate each run.
DISCOVERY_MAX_SERPAPI_QUERIES=2
DISCOVERY_QUERIES_PER_CYCLE=2
DISCOVERY_SEARCH_RESULTS_PER_QUERY=5
DISCOVERY_SERP_MAX_PAGES=5
AUTO_APPROVE_MIN_CONFIDENCE=75
AUTO_APPROVE_MIN_PROOF=50
VERIFICATION_MIN_CORPUS_CHARS=500
VERIFICATION_BLOCK_AUTO_APPROVE_ON_RISK=true
VERIFICATION_MIN_PROOF_FOR_ESTIMATED_PRICE=60

# Optional LLM extraction (OpenAI-compatible chat completions)
DISCOVERY_LLM_API_URL=
DISCOVERY_LLM_API_KEY=
DISCOVERY_LLM_MODEL=gpt-4o-mini

# Admin access (set in production)
ADMIN_PASSWORD=

# Public site URL (match links in email)
APP_URL=http://127.0.0.1:8000

# Spotify Web API (Client Credentials)
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Copy Client ID + Client Secret here
# 3. Restart the server, then verify: GET /health?spotify=1
# Note: new apps often cannot call /audio-features or /top-tracks (403).
# SoundMatch still uses /artists/{id} for genres, followers, popularity and estimates sonic averages.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional market for track lookups (ISO country code)
SPOTIFY_MARKET=US

# Optional LLM for deeper lyrical synthesis (OpenAI-compatible)
# ANALYSIS_LLM_API_URL=
# ANALYSIS_LLM_API_KEY=
# ANALYSIS_LLM_MODEL=gpt-4o-mini

# Optional Genius API — attaches song page links for lyrical review (public API does not return full lyrics)
# GENIUS_ACCESS_TOKEN=

# Disable demo seed in production
SOUNDMATCH_SKIP_AUTO_SEED=1

# Optional cron secret for scheduled discovery without browser login
DISCOVERY_CRON_SECRET=
# Format: [{"name":"Directory Name","url":"https://example.com","type":"manual"}]
# For now, leave empty or add manual entries for admin review
WEB_DIRECTORIES=[]
